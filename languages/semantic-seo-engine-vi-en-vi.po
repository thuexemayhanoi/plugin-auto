msgstr "Cần người xem xét"

#: includes/Approval/ApprovalService.php:39 includes/Approval/ChangeExecutor.php:84
msgid "Proposal not found."
msgstr "Không tìm thấy đề xuất."

#: includes/Approval/ApprovalService.php:42
msgid "Only previewed proposals can be approved."
msgstr "Chỉ có thể phê duyệt đề xuất đang ở trạng thái xem trước."

#: includes/Approval/ApprovalService.php:55
msgid "The content changed after this preview was created. Create a new preview."
msgstr "Nội dung đã thay đổi sau khi tạo bản xem trước này. Hãy tạo bản xem trước mới."

#: includes/Approval/ApprovalService.php:113 includes/Rollback/RollbackService.php:52 includes/Rollback/RollbackService.php:79
msgid "Only applied changes can be rolled back."
msgstr "Chỉ có thể hoàn tác thay đổi đã áp dụng."

#: includes/Approval/ApprovalService.php:176
msgid "Approval not found."
msgstr "Không tìm thấy phê duyệt."

#: includes/Approval/ApprovalService.php:180
msgid "The approval does not match this change."
msgstr "Phê duyệt không khớp với thay đổi này."

#: includes/Approval/ApprovalService.php:183
msgid "The approval was already used, revoked or invalidated."
msgstr "Phê duyệt đã được dùng, bị thu hồi hoặc bị vô hiệu."

#: includes/Approval/ApprovalService.php:187
msgid "The approval has expired; approve again."
msgstr "Phê duyệt đã hết hạn; hãy phê duyệt lại."

#: includes/Approval/ApprovalService.php:194
msgid "The approval was already used."
msgstr "Phê duyệt đã được sử dụng."

#: includes/Approval/ApprovalService.php:253
msgid "Approvals can only be given by a human administrator in WP Admin."
msgstr "Chỉ quản trị viên là con người, thao tác trong WP Admin, mới được phê duyệt."

#: includes/Approval/ApprovalService.php:257
msgid "You do not have permission to approve changes."
msgstr "Bạn không có quyền phê duyệt thay đổi."

#: includes/Approval/ChangeExecutor.php:62
msgid "You do not have permission to apply changes."
msgstr "Bạn không có quyền áp dụng thay đổi."

#: includes/Approval/ChangeExecutor.php:66
msgid "An idempotency key (8–64 characters) is required."
msgstr "Cần idempotency key (8–64 ký tự)."

#: includes/Approval/ChangeExecutor.php:72
msgid "This idempotency key was already used for another change."
msgstr "Idempotency key này đã được dùng cho một thay đổi khác."

#: includes/Approval/ChangeExecutor.php:87
msgid "This proposal has no active human approval."
msgstr "Đề xuất này chưa có phê duyệt còn hiệu lực của con người."

#: includes/Approval/ChangeExecutor.php:92
msgid "The approval does not belong to this proposal."
msgstr "Phê duyệt không thuộc đề xuất này."

#: includes/Approval/ChangeExecutor.php:96
msgid "The approval scope does not match."
msgstr "Phạm vi phê duyệt không khớp."

#: includes/Approval/ChangeExecutor.php:99
msgid "This URL is locked by an administrator."
msgstr "URL này đã bị quản trị viên khóa."

#: includes/Approval/ChangeExecutor.php:103 includes/Rollback/RollbackService.php:73
msgid "Another change to this object is in progress."
msgstr "Đang có một thay đổi khác cho đối tượng này."

#: includes/Approval/ChangeExecutor.php:133
msgid "The content changed after approval; nothing was written. Create a new preview."
msgstr "Nội dung đã thay đổi sau khi phê duyệt; chưa ghi gì. Hãy tạo bản xem trước mới."

#: includes/Approval/ChangeExecutor.php:136
msgid "The post is no longer published; nothing was written."
msgstr "Bài viết không còn ở trạng thái xuất bản; chưa ghi gì."

#: includes/Approval/ChangeExecutor.php:140
msgid "The linked page is no longer published at the approved URL; nothing was written. Create a new preview."
msgstr "Trang đích không còn được xuất bản tại URL đã phê duyệt; chưa ghi gì. Hãy tạo bản xem trước mới."

#: includes/Approval/ChangeExecutor.php:148
msgid "The computed result does not match the approved diff; nothing was written."
msgstr "Kết quả tính toán không khớp diff đã phê duyệt; chưa ghi gì."

#: includes/Approval/ChangeExecutor.php:157
msgid "The permalink structure now contains this taxonomy: applying could change the post URL; nothing was written."
msgstr "Cấu trúc permalink hiện chứa taxonomy này: áp dụng có thể làm đổi URL bài viết; chưa ghi gì."

#: includes/Approval/ChangeExecutor.php:160
msgid "The term no longer exists; nothing was written."
msgstr "Chuyên mục/thẻ không còn tồn tại; chưa ghi gì."

#: includes/Approval/ChangeExecutor.php:249
msgid "A concurrent apply with the same idempotency key is in progress."
msgstr "Đang có một lần áp dụng đồng thời với cùng idempotency key."

#: includes/Approval/ChangeExecutor.php:359
msgid "The post was edited at the same moment; nothing was written. Create a new preview."
msgstr "Bài viết vừa được người khác sửa cùng lúc; chưa ghi gì. Hãy tạo bản xem trước mới."

#: includes/Approval/ChangeExecutor.php:368
msgid "The write failed before anything was changed (see change log)."
msgstr "Thao tác ghi thất bại trước khi có thay đổi nào (xem nhật ký thay đổi)."

