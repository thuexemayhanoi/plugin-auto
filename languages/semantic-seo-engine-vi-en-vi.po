#: includes/Abilities/AbilitiesRegistrar.php:51
msgid "Inspect inventory and SEO analyses, run bounded jobs, preview and (with human approval) apply reversible changes."
msgstr "Xem kiểm kê và phân tích SEO, chạy tác vụ có giới hạn, xem trước và (khi con người đã phê duyệt) áp dụng thay đổi có thể hoàn tác."

#: includes/Abilities/AbilitiesRegistrar.php:64
msgid "Get Semantic SEO site status"
msgstr "Xem trạng thái Semantic SEO của website"

#: includes/Abilities/AbilitiesRegistrar.php:65
msgid "Returns plugin version, read-only mode, available compute tiers, index counts, link-scan coverage, findings summary and diagnostics. Use first to test the connection."
msgstr "Trả về phiên bản plugin, chế độ chỉ-đọc, các tầng xử lý khả dụng, số lượng chỉ mục, phạm vi quét liên kết, tóm tắt phát hiện và chẩn đoán. Dùng đầu tiên để kiểm tra kết nối."

#: includes/Abilities/AbilitiesRegistrar.php:74
msgid "List inventoried URLs"
msgstr "Liệt kê URL đã kiểm kê"

#: includes/Abilities/AbilitiesRegistrar.php:75
msgid "Paginated SEO Matrix rows (locale, status, intent, cluster role, link counts, QA and risk counts) with provenance. Filter by locale/type/intent; use next_cursor to page."
msgstr "Các dòng Ma trận SEO có phân trang (ngôn ngữ, trạng thái, ý định, vai trò cụm, số liên kết, số vấn đề QA và rủi ro) kèm nguồn gốc. Lọc theo ngôn ngữ/loại/ý định; dùng next_cursor để sang trang."

#: includes/Abilities/AbilitiesRegistrar.php:81
msgid "Get URL analysis"
msgstr "Xem phân tích một URL"

#: includes/Abilities/AbilitiesRegistrar.php:82
msgid "Structured evidence for one URL: facts (headings, links, counts) separated from inferences (heuristic intent, topics, pattern entities), QA issues, link suggestions, overlap risks and provenance."
msgstr "Bằng chứng có cấu trúc cho một URL: dữ kiện (heading, liên kết, số đếm) tách riêng khỏi suy luận (ý định, chủ đề, thực thể theo mẫu), vấn đề QA, gợi ý liên kết, rủi ro chồng lấn và nguồn gốc."

#: includes/Abilities/AbilitiesRegistrar.php:88
msgid "Get internal link suggestions"
msgstr "Xem gợi ý liên kết nội bộ"

#: includes/Abilities/AbilitiesRegistrar.php:89
msgid "Ranked source→target internal link candidates with reasons, anchor text, exact location and evidence components, plus orphan candidates with scan coverage. Suggestions only."
msgstr "Các ứng viên liên kết nội bộ nguồn→đích đã xếp hạng, kèm lý do, anchor, vị trí chính xác và thành phần bằng chứng, cùng các trang có thể mồ côi với phạm vi quét. Chỉ là gợi ý."

#: includes/Abilities/AbilitiesRegistrar.php:95
msgid "Get cannibalization risk report"
msgstr "Xem báo cáo rủi ro ăn thịt từ khóa"

#: includes/Abilities/AbilitiesRegistrar.php:96
msgid "Same-locale overlap pairs classified as duplicate, potential competition, different intent, distinct facet, pillar/supporting or manual review, with evidence and uncertainty. Risk hypotheses, not verdicts."
msgstr "Các cặp chồng lấn cùng ngôn ngữ được phân loại: trùng lặp, có thể cạnh tranh, khác ý định, khía cạnh riêng, trụ cột/hỗ trợ hoặc cần xem thủ công, kèm bằng chứng và mức độ không chắc chắn. Là giả thuyết rủi ro, không phải kết luận."

#: includes/Abilities/AbilitiesRegistrar.php:102
msgid "Get topic clusters"
msgstr "Xem cụm chủ đề"

#: includes/Abilities/AbilitiesRegistrar.php:103
msgid "Taxonomy-based Pillar/Hub/Silo tree per locale with members, recommended pillar pages and evidence. Editorial recommendations."
msgstr "Cây Pillar/Hub/Silo theo phân loại cho từng ngôn ngữ, kèm thành viên, trang trụ cột khuyến nghị và bằng chứng. Là khuyến nghị biên tập."

#: includes/Abilities/AbilitiesRegistrar.php:109
msgid "Get content QA issues"
msgstr "Xem vấn đề chất lượng nội dung"

#: includes/Abilities/AbilitiesRegistrar.php:110
msgid "QA checks labelled verified_error, warning or suggestion (never conflated), filterable by severity, label, check and URL."
msgstr "Các kiểm tra QA được gắn nhãn verified_error, warning hoặc suggestion (không bao giờ gộp lẫn), lọc theo mức độ, nhãn, quy tắc và URL."

#: includes/Abilities/AbilitiesRegistrar.php:116
msgid "Get job status"
msgstr "Xem trạng thái tác vụ"

#: includes/Abilities/AbilitiesRegistrar.php:117
msgid "Status (queued/running/paused/failed/completed/cancelled), phase and honest progress of a job."
msgstr "Trạng thái (chờ/đang chạy/tạm dừng/lỗi/hoàn thành/đã hủy), giai đoạn và tiến độ thực của một tác vụ."

#: includes/Abilities/AbilitiesRegistrar.php:125
msgid "Get audit log"
msgstr "Xem nhật ký kiểm toán"

#: includes/Abilities/AbilitiesRegistrar.php:126
msgid "Redacted action history. Agents only receive their own entries."
msgstr "Lịch sử thao tác đã ẩn thông tin nhạy cảm. Agent chỉ nhận được mục của chính mình."

#: includes/Abilities/AbilitiesRegistrar.php:132
msgid "Start a bounded analysis job"
msgstr "Khởi chạy tác vụ phân tích có giới hạn"

#: includes/Abilities/AbilitiesRegistrar.php:133
msgid "Starts an inventory, analysis, embedding or link-verification job (max 200 target posts, one active job per type, idempotency key supported). Read-only with respect to site content."
msgstr "Khởi chạy tác vụ kiểm kê, phân tích, vector nhúng hoặc kiểm tra liên kết (tối đa 200 bài mục tiêu, mỗi loại một tác vụ đang chạy, hỗ trợ idempotency key). Chỉ đọc đối với nội dung website."

#: includes/Abilities/AbilitiesRegistrar.php:139
msgid "Cancel a job"
msgstr "Hủy tác vụ"

#: includes/Abilities/AbilitiesRegistrar.php:140
msgid "Requests cancellation of a job; it stops at the next batch boundary."
msgstr "Yêu cầu hủy tác vụ; tác vụ dừng ở ranh giới lô kế tiếp."

#: includes/Abilities/AbilitiesRegistrar.php:148
msgid "Rebuild the derived index"
msgstr "Xây dựng lại chỉ mục dẫn xuất"

#: includes/Abilities/AbilitiesRegistrar.php:149
msgid "Re-indexes lexical data or re-queues embeddings for the pinned model (confirm=true required). Never modifies posts."
msgstr "Lập chỉ mục lại dữ liệu từ vựng hoặc xếp hàng lại vector nhúng cho mô hình cố định (cần confirm=true). Không bao giờ sửa bài viết."

#: includes/Abilities/AbilitiesRegistrar.php:155
msgid "Create change previews"
msgstr "Tạo bản xem trước thay đổi"

#: includes/Abilities/AbilitiesRegistrar.php:156
msgid "Turns 1–10 findings into exact, hash-bound diff previews. Nothing is written; a human must approve in WP Admin."
msgstr "Biến 1–10 phát hiện thành bản xem trước diff chính xác, gắn mã băm. Không ghi gì; con người phải phê duyệt trong WP Admin."

#: includes/Abilities/AbilitiesRegistrar.php:162
msgid "Apply a human-approved change"
msgstr "Áp dụng thay đổi đã được con người phê duyệt"

#: includes/Abilities/AbilitiesRegistrar.php:163
msgid "Applies a proposal that a human approved in WP Admin. Requires the approval ID and an idempotency key; rejects stale, expired, mismatched or reused approvals; returns readback verification."
msgstr "Áp dụng đề xuất đã được con người phê duyệt trong WP Admin. Cần ID phê duyệt và idempotency key; từ chối phê duyệt lỗi thời, hết hạn, không khớp hoặc đã dùng; trả về kết quả đọc lại xác minh."

#: includes/Abilities/AbilitiesRegistrar.php:169
msgid "Roll back a change"
msgstr "Hoàn tác một thay đổi"

#: includes/Abilities/AbilitiesRegistrar.php:170
msgid "Restores a change made by this plugin. Non-interactive callers need a separate human-issued rollback approval."
msgstr "Khôi phục thay đổi do plugin này thực hiện. Bên gọi không tương tác cần một phê duyệt hoàn tác riêng do con người cấp."

#: includes/Analysis/PriorityQueue.php:314
msgid "Edit the post and point the link to a live page, or remove it."
msgstr "Sửa bài: trỏ liên kết tới một trang còn hoạt động, hoặc gỡ liên kết."

#: includes/Analysis/PriorityQueue.php:315
msgid "Readers and search engines no longer reach an error page, and the link passes value again."
msgstr "Người đọc và công cụ tìm kiếm không còn gặp trang lỗi, liên kết lại có giá trị."

#: includes/Analysis/PriorityQueue.php:321
msgid "Write a title that names the topic of the page."
msgstr "Viết tiêu đề nêu rõ chủ đề của trang."

#: includes/Analysis/PriorityQueue.php:322
msgid "Search results and browser tabs show what the page is about."
msgstr "Kết quả tìm kiếm và tab trình duyệt cho biết trang nói về gì."

#: includes/Analysis/PriorityQueue.php:325
msgid "Check the canonical in the SEO plugin: each language version should normally point to itself and be linked with hreflang."
msgstr "Kiểm tra canonical trong plugin SEO: thông thường mỗi phiên bản ngôn ngữ trỏ canonical về chính nó và được nối với nhau bằng hreflang."

#: includes/Analysis/PriorityQueue.php:326
msgid "The page can be indexed in its own language instead of being folded into the other one."
msgstr "Trang được lập chỉ mục bằng ngôn ngữ của nó thay vì bị gộp vào phiên bản ngôn ngữ kia."

#: includes/Analysis/PriorityQueue.php:329
msgid "Give each page a title that says how it differs from the other one."
msgstr "Đặt cho mỗi trang một tiêu đề nói rõ điểm khác với trang kia."

#: includes/Analysis/PriorityQueue.php:330
msgid "Search engines and readers can tell the pages apart."
msgstr "Công cụ tìm kiếm và người đọc phân biệt được các trang."

#: includes/Analysis/PriorityQueue.php:333
msgid "Confirm the canonical is intentional; if not, correct it in the SEO plugin."
msgstr "Xác nhận canonical là có chủ ý; nếu không, sửa lại trong plugin SEO."

#: includes/Analysis/PriorityQueue.php:334
msgid "The page you want indexed is the one search engines keep."
msgstr "Trang bạn muốn được lập chỉ mục chính là trang công cụ tìm kiếm giữ lại."

#: includes/Analysis/PriorityQueue.php:337
msgid "Check that the post is assigned to the right language."
msgstr "Kiểm tra bài đã được gán đúng ngôn ngữ chưa."

#: includes/Analysis/PriorityQueue.php:338
msgid "Visitors of each language find content in their language; hreflang stays consistent."
msgstr "Người đọc mỗi ngôn ngữ thấy nội dung đúng ngôn ngữ của mình; hreflang nhất quán."

#: includes/Analysis/PriorityQueue.php:341
msgid "Compare the two pages; make each one answer a different need, or keep one as the main page."
msgstr "So sánh hai trang; để mỗi trang đáp ứng một nhu cầu khác nhau, hoặc chọn một trang làm trang chính."

#: includes/Analysis/PriorityQueue.php:342 includes/Analysis/PriorityQueue.php:422
msgid "Fewer pages competing with each other for the same searches."
msgstr "Ít trang cạnh tranh nhau cho cùng một truy vấn hơn."

#: includes/Analysis/PriorityQueue.php:345
msgid "Add a link to this page from one or two related posts (see the link suggestions)."
msgstr "Thêm liên kết tới trang này từ một hai bài liên quan (xem gợi ý liên kết)."

#: includes/Analysis/PriorityQueue.php:346
msgid "Readers and crawlers can reach the page from the rest of the site."
msgstr "Người đọc và bot tìm kiếm đến được trang này từ các phần khác của website."

#: includes/Analysis/PriorityQueue.php:349
msgid "Update the link to the final URL."
msgstr "Cập nhật liên kết về URL cuối cùng."

#: includes/Analysis/PriorityQueue.php:350
msgid "One redirect less for readers and crawlers."
msgstr "Bớt một lần chuyển hướng cho người đọc và bot tìm kiếm."

#: includes/Analysis/PriorityQueue.php:353
msgid "Open the link once; fix it if it does not lead to the intended page."
msgstr "Mở thử liên kết; sửa nếu nó không dẫn tới đúng trang."

#: includes/Analysis/PriorityQueue.php:354
msgid "No hidden broken links."
msgstr "Không còn liên kết hỏng bị ẩn."

#: includes/Analysis/PriorityQueue.php:357
msgid "Check whether the page should really be noindex; if so, consider linking to an indexable page instead."
msgstr "Kiểm tra trang có thật sự cần noindex không; nếu có, cân nhắc liên kết tới một trang được lập chỉ mục."

#: includes/Analysis/PriorityQueue.php:358
msgid "Internal links point to pages that can appear in search."
msgstr "Liên kết nội bộ trỏ tới các trang có thể xuất hiện trên kết quả tìm kiếm."

#: includes/Analysis/PriorityQueue.php:361
msgid "Link to the main pages of the same topic group."
msgstr "Liên kết tới các trang chính trong cùng nhóm chủ đề."

#: includes/Analysis/PriorityQueue.php:362
msgid "The topic group is easier to navigate and its structure is clearer."
msgstr "Nhóm chủ đề dễ điều hướng hơn và cấu trúc rõ ràng hơn."

#: includes/Analysis/PriorityQueue.php:365
msgid "Write a meta description specific to each page."
msgstr "Viết meta description riêng cho từng trang."

#: includes/Analysis/PriorityQueue.php:366
msgid "Search snippets describe each page instead of repeating the same text."
msgstr "Đoạn mô tả trên kết quả tìm kiếm nói đúng về từng trang thay vì lặp lại cùng một nội dung."

#: includes/Analysis/PriorityQueue.php:369
msgid "Write a short meta description in the SEO plugin."
msgstr "Viết một meta description ngắn trong plugin SEO."

#: includes/Analysis/PriorityQueue.php:370
msgid "You choose the snippet text instead of leaving it to the search engine."
msgstr "Bạn tự chọn đoạn mô tả thay vì để công cụ tìm kiếm tự lấy."

#: includes/Analysis/PriorityQueue.php:373
msgid "Check the page with a structured data testing tool and keep one source of each schema type."
msgstr "Kiểm tra trang bằng công cụ kiểm tra dữ liệu có cấu trúc và chỉ giữ một nguồn cho mỗi loại schema."

#: includes/Analysis/PriorityQueue.php:374
msgid "Structured data stays valid and unambiguous."
msgstr "Dữ liệu có cấu trúc hợp lệ và không mơ hồ."

#: includes/Analysis/PriorityQueue.php:377
msgid "Check whether the page fully answers the question; add the missing details (prices, steps, conditions, examples) if not."
msgstr "Kiểm tra trang đã trả lời đầy đủ câu hỏi chưa; nếu chưa, bổ sung chi tiết còn thiếu (giá, các bước, điều kiện, ví dụ)."

#: includes/Analysis/PriorityQueue.php:378
msgid "A more complete answer for readers. Length alone is not a goal."
msgstr "Câu trả lời đầy đủ hơn cho người đọc. Độ dài tự nó không phải mục tiêu."

#: includes/Analysis/PriorityQueue.php:381
msgid "Split the text into sections with H2 subheadings."
msgstr "Chia nội dung thành các phần có tiêu đề phụ H2."

#: includes/Analysis/PriorityQueue.php:382
msgid "Easier to scan and to quote in search answers."
msgstr "Dễ đọc lướt và dễ được trích dẫn trong câu trả lời tìm kiếm."

#: includes/Analysis/PriorityQueue.php:385
msgid "Use heading levels in order (H2, then H3)."
msgstr "Dùng cấp tiêu đề theo thứ tự (H2 rồi đến H3)."

#: includes/Analysis/PriorityQueue.php:386
msgid "A clearer outline for readers and assistive technology."
msgstr "Dàn ý rõ ràng hơn cho người đọc và công nghệ hỗ trợ."

#: includes/Analysis/PriorityQueue.php:389
msgid "Check that the page has a single H1 (the theme usually prints the title as H1)."
msgstr "Kiểm tra trang chỉ có một H1 (giao diện thường đã in tiêu đề bài thành H1)."

#: includes/Analysis/PriorityQueue.php:390
msgid "A clear main heading."
msgstr "Tiêu đề chính rõ ràng."

#: includes/Analysis/PriorityQueue.php:393
msgid "Add a short alt text that describes each image."
msgstr "Thêm mô tả alt ngắn cho từng ảnh."

#: includes/Analysis/PriorityQueue.php:394
msgid "Accessible images that image search can understand."
msgstr "Ảnh dễ tiếp cận và công cụ tìm kiếm hình ảnh hiểu được."

#: includes/Analysis/PriorityQueue.php:397
msgid "Where facts are stated, cite a reliable source."
msgstr "Khi nêu số liệu hay dữ kiện, hãy dẫn nguồn đáng tin cậy."

#: includes/Analysis/PriorityQueue.php:398
msgid "Statements readers can verify."
msgstr "Người đọc kiểm chứng được thông tin."

#: includes/Analysis/PriorityQueue.php:401
msgid "Reword the repeated phrase where it does not read naturally."
msgstr "Diễn đạt lại cụm từ bị lặp ở những chỗ đọc chưa tự nhiên."

#: includes/Analysis/PriorityQueue.php:402
msgid "More natural text; avoids looking like keyword stuffing."
msgstr "Văn bản tự nhiên hơn; tránh bị coi là nhồi nhét từ khóa."

#: includes/Analysis/PriorityQueue.php:405
msgid "Check how the title looks in search results; shorten or complete it if needed."
msgstr "Xem tiêu đề hiển thị thế nào trên kết quả tìm kiếm; rút gọn hoặc bổ sung nếu cần."

#: includes/Analysis/PriorityQueue.php:406
msgid "A title that is not cut off and says enough."
msgstr "Tiêu đề không bị cắt và nói đủ ý."

#: includes/Analysis/PriorityQueue.php:409
msgid "Translate the page if it matters for visitors of the other language, then link the two versions."
msgstr "Dịch trang nếu nó hữu ích cho người đọc ngôn ngữ kia, rồi liên kết hai phiên bản với nhau."

#: includes/Analysis/PriorityQueue.php:410
msgid "Visitors of each language get the page in their language."
msgstr "Người đọc mỗi ngôn ngữ có trang bằng ngôn ngữ của mình."

#: includes/Analysis/PriorityQueue.php:413
msgid "If the two pages are translations of each other, link them in the language plugin."
msgstr "Nếu hai trang là bản dịch của nhau, hãy liên kết chúng trong plugin đa ngôn ngữ."

#: includes/Analysis/PriorityQueue.php:414
msgid "Correct hreflang between the two language versions."
msgstr "Hreflang đúng giữa hai phiên bản ngôn ngữ."

#: includes/Analysis/PriorityQueue.php:417
msgid "Decide which page to keep as the main one. Do not delete or redirect without checking traffic and links first."
msgstr "Quyết định giữ trang nào làm trang chính. Không xóa hay chuyển hướng khi chưa kiểm tra lượt truy cập và liên kết."

#: includes/Analysis/PriorityQueue.php:418
msgid "One clear page for the topic instead of two identical ones."
msgstr "Một trang rõ ràng cho chủ đề thay vì hai trang giống hệt nhau."

#: includes/Analysis/PriorityQueue.php:421
msgid "Compare the two pages; differentiate them or keep one as the main page. Similar text alone is not a reason to merge, delete or redirect."
msgstr "So sánh hai trang; làm chúng khác biệt hoặc chọn một trang làm trang chính. Chỉ giống nhau về nội dung không phải lý do để gộp, xóa hay chuyển hướng."

#: includes/Analysis/PriorityQueue.php:425
msgid "Check in Search Console whether both pages show for the same queries; if so, give each page a distinct focus and link the supporting page to the main one."
msgstr "Kiểm tra trong Search Console xem hai trang có cùng hiển thị cho một truy vấn không; nếu có, cho mỗi trang một trọng tâm riêng và liên kết trang bổ trợ về trang chính."

#: includes/Analysis/PriorityQueue.php:426
msgid "Each search need has one clear page."
msgstr "Mỗi nhu cầu tìm kiếm có một trang rõ ràng."

#: includes/Analysis/PriorityQueue.php:429
msgid "Check the translation links in the language plugin: each page should have at most one translation per language."
msgstr "Kiểm tra liên kết bản dịch trong plugin đa ngôn ngữ: mỗi trang chỉ nên có tối đa một bản dịch cho mỗi ngôn ngữ."

#: includes/Analysis/PriorityQueue.php:430
msgid "Consistent hreflang between language versions."
msgstr "Hreflang nhất quán giữa các phiên bản ngôn ngữ."

#: includes/Analysis/PriorityQueue.php:433
msgid "Add the suggested link with the proposed anchor text (preview and approval are required before anything is written)."
msgstr "Thêm liên kết được gợi ý với anchor text đề xuất (phải xem trước và phê duyệt trước khi ghi bất cứ gì)."

#: includes/Analysis/PriorityQueue.php:434
msgid "Related pages are connected for readers and crawlers."
msgstr "Các trang liên quan được kết nối cho người đọc và bot tìm kiếm."

#: includes/Analysis/PriorityQueue.php:437
msgid "Confirm the suggested pillar page for this topic group, or choose another one, and link the group members to it."
msgstr "Xác nhận bài trụ cột được đề xuất cho nhóm chủ đề này (hoặc chọn bài khác) và liên kết các bài trong nhóm về đó."

#: includes/Analysis/PriorityQueue.php:438
msgid "A clear Pillar–Hub–Silo structure for the topic."
msgstr "Cấu trúc Pillar–Hub–Silo rõ ràng cho chủ đề."

#: includes/Analysis/PriorityQueue.php:443
msgid "Review the finding."
msgstr "Xem lại phát hiện."

#: includes/Analysis/PriorityQueue.php:463
msgid "Two pages with identical content"
msgstr "Hai trang có nội dung giống hệt nhau"

#: includes/Analysis/PriorityQueue.php:464
msgid "Two pages with nearly the same content"
msgstr "Hai trang có nội dung gần như giống nhau"

#: includes/Analysis/PriorityQueue.php:465
msgid "Two pages may compete for the same searches"
msgstr "Hai trang có thể cạnh tranh cùng truy vấn tìm kiếm"

#: includes/Analysis/PriorityQueue.php:466
msgid "Conflicting translation links"
msgstr "Liên kết bản dịch mâu thuẫn"

#: includes/Analysis/PriorityQueue.php:467
msgid "Missing internal link to a related page"
msgstr "Thiếu liên kết nội bộ tới trang liên quan"

#: includes/Analysis/PriorityQueue.php:468
msgid "Topic group without a confirmed pillar page"
msgstr "Nhóm chủ đề chưa có bài trụ cột được xác nhận"

